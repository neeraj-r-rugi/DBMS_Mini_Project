# SQLite is the zero-configuration local demo fallback
DATABASE_URL=sqlite:///backend/demo.db
# Production example: mysql+pymysql://user:password@localhost:3306/used_car_app
MODEL_PATH=used_cars_knn_model.pkl
# CouchDB REST endpoint and credentials. Leave COUCHDB_USER empty for local
# CouchDB installations with authentication disabled.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
COUCHDB_CAR_DATABASE=used_car
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
